# nhuthungfoto Backend — Environment Reference
# Secrets are managed via `wrangler secret put <KEY>` (prod) or `.dev.vars` (local dev).
# Non-secret vars are set in wrangler.jsonc under "vars".

# --------------------
# Secrets (.dev.vars / wrangler secret)
# --------------------

# Cloudflare R2 S3-compatible API (for pre-signed URLs)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI Grading
GEMINI_API_KEY=
OPENAI_API_KEY=

# Payments
SEPAY_API_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

#ADMIN_EMAILS
ADMIN_EMAILS=

#Sentry Keys
SENTRY_API_KEY=

#TELEGRAM 
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL Telegram posts callbacks to (see `npm run telegram:webhook -- set --url=...`).
# Not read at runtime; only used by the webhook registration script / reference.
TELEGRAM_WEBHOOK_URL=

